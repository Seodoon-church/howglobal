rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 자료실 파일: 공개 다운로드, 업로드는 관리자만
    match /library/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'howintlsoft@gmail.com'
      );
    }
  }
}
